# whisper-ollama-enricher — Docker configuration
# Copy to docker/.env and fill in values: cp docker/.env.example docker/.env
#
# Only the vault is mounted into the container (at /vault), so INBOX_PATH and
# OUTPUT_PATH must live inside the vault, otherwise the container sees no files.

# Host path to the Obsidian vault (mounted as /vault). Also satisfies VAULT_PATH.
VAULT_PATH=/home/USER/obsidian

# Paths as seen INSIDE the container.
INBOX_PATH=/vault/0_inbox
OUTPUT_PATH=/vault/1_enriched

# Ollama on the Docker host: 172.17.0.1 works for the default bridge network.
OLLAMA_BASE_URL=http://172.17.0.1:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=60

# Host user/group IDs so written notes are owned by you: run `id -u` / `id -g`.
CURRENT_UID=1000
CURRENT_GID=1000

LOG_LEVEL=INFO
